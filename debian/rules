#!/usr/bin/make -f

# Rust 1.92+ is supplied by Debian trixie-backports.
export CARGO_PROFILE_RELEASE_STRIP = false
export CARGO_PROFILE_RELEASE_DEBUG = 1

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	cargo test --locked

override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/liims-browser

override_dh_auto_clean:
	rm -rf target

# make install already installs the user unit. Do not generate service scripts:
# enabling and starting it is left to the terminal's session setup.
override_dh_installsystemduser:
	:
